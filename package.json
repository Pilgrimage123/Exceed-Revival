{
  "name": "exceed-revival",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build:game": "node scripts/build-game.mjs",
    "build": "node scripts/build-game.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/exceed.test.ts tests/belief-engine.test.ts tests/native-protocol.test.ts",
    "native:export-roster": "node scripts/export-card-dsl.mjs",
    "native:test": "cargo test --manifest-path native/Cargo.toml",
    "native:build": "cargo build --release --manifest-path native/Cargo.toml",
    "native:wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path native/Cargo.toml"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
